# ===== Backend: Spring Boot, Java 21 =====
# Build context là thư mục gốc repo (xem docker-compose.yml), nên COPY có tiền tố backend/

# --- Giai đoạn 1: build file .jar ---
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Tải thư viện trước: pom.xml không đổi thì Docker dùng lại cache, build nhanh hơn nhiều
COPY backend/pom.xml .
RUN mvn -B dependency:go-offline
COPY backend/src ./src
RUN mvn -B clean package -DskipTests

# --- Giai đoạn 2: chạy bằng JRE nhẹ, user thường ---
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S spring && adduser -S spring -G spring
COPY --from=build --chown=spring:spring /app/target/*.jar app.jar
USER spring
EXPOSE 8080
# MaxRAMPercentage: JVM không chiếm quá 75% RAM của container (server dùng chung)
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
